# ==============================================================================
# AG POWER Solar - Environment Configuration Template
# Copy this file to .env.local and fill in the values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth & Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER ONLY: Never expose SUPABASE_SERVICE_ROLE_KEY to client!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ------------------------------------------------------------------------------
# 2. Site & Admin URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://ag-power-solar.vercel.app
NEXT_PUBLIC_SITE_URL=https://ag-power-solar.vercel.app
OWNER_EMAIL=owner@agpowersolar.com
CUSTOM_ADMIN_PATH=admin
CRON_SECRET=your-random-cron-secret-32-chars

# ------------------------------------------------------------------------------
# 3. Notification & Email Services (SMTP / Zoho / Leads)
# ------------------------------------------------------------------------------
LEADS_NOTIFY_TO=leads@agpowersolar.com
LEADS_REPLY_TO=contact@agpowersolar.com
NOTIFY_EMAILS=owner@agpowersolar.com,admin@agpowersolar.com
MAIL_FROM=notifications@agpowersolar.com
MAIL_FROM_NAME="AG POWER Solar"

# Zoho SMTP (Optional)
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=contact@agpowersolar.com
ZOHO_SMTP_PASS=your-zoho-app-password
ZOHO_SMTP_FROM=contact@agpowersolar.com

# ------------------------------------------------------------------------------
# 4. Google Integrations (Sheets, Search Console & Forms)
# ------------------------------------------------------------------------------
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
GOOGLE_SITE_VERIFICATION=your-google-search-console-verification-code
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=

# ------------------------------------------------------------------------------
# 5. Cloudflare & AI Gateway (Optional)
# ------------------------------------------------------------------------------
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_SEO_MODEL=gpt-4o-mini
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY=

# ------------------------------------------------------------------------------
# 6. Security & Anti-Bot
# ------------------------------------------------------------------------------
IP_HASH_SALT=your-unique-ip-hash-salt
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REQUIRE_ADMIN_MFA=false
