# Mommantum — environment variables (copy to .env.local for local dev; set in Vercel for prod).
# Never commit real values. Secrets live only in Vercel → Project → Settings → Environment Variables.

# ── Site ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://www.mommantum.com
# Comma-separated extra origins allowed to call admin APIs (e.g. a staging domain)
ALLOWED_ORIGINS=
# "true" on staging/preview: noindex everywhere + robots Disallow /
NEXT_PUBLIC_NOINDEX=
# Optional: X/Twitter handle for twitter:site, e.g. @mommantum
NEXT_PUBLIC_TWITTER_HANDLE=
# Optional: Google Search Console HTML-tag verification code
GOOGLE_SITE_VERIFICATION=

# ── Supabase ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional but recommended: Supabase → Settings → API → JWT secret (fast local token verification)
SUPABASE_JWT_SECRET=

# ── Admin access ──────────────────────────────────────────────────────────────────────
# Owner account (cannot be edited/demoted/deleted by anyone else)
OWNER_EMAIL=sharmasaurabh2604@gmail.com
# "true" forces owner/admin accounts to set up 2FA before using the admin panel
REQUIRE_ADMIN_MFA=false
# REQUIRED for blog preview links (dedicated secret, no fallback). Generate with: openssl rand -hex 32
PREVIEW_SECRET=
# Optional disguised admin URL, e.g. "studio" → /studio and /studio-login (a-z, 0-9, hyphen)
CUSTOM_ADMIN_PATH=admin

# ── Machine-to-machine keys (generate with: openssl rand -hex 32) ─────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# External blog publisher (n8n / Blog-AI engine) → POST /api/blog/publish and /api/blog/upload
PUBLISH_API_KEY=
# Salt for hashing visitor IPs on leads (DPDP: raw IPs are never stored). Set it: without it a
# random per-instance salt is used and hashes cannot be compared across instances.
IP_HASH_SALT=

# ── Email: Zoho SMTP (all transactional mail) ─────────────────────────────────────────
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
# Zoho → My Account → Security → App Passwords (not your login password)
ZOHO_SMTP_PASS=
# Optional: From address if different from the SMTP user (must be on the same Zoho domain)
ZOHO_SMTP_FROM=
MAIL_FROM_NAME=Mommantum
# Who receives new-lead emails (comma separated); defaults to OWNER_EMAIL
LEADS_NOTIFY_TO=
# Reply-To address on the visitor auto-reply
LEADS_REPLY_TO=
# Extra people who receive admin notification emails (comma separated)
NOTIFY_EMAILS=

# ── Google Sheet copy of leads ────────────────────────────────────────────────────────
# Option A (recommended): Sheets API with a service account. Share the sheet with the
# service-account email as Editor. Tab name + range below.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Leads!A:I
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n for newlines
GOOGLE_PRIVATE_KEY=
# Option B (zero setup): leave Option A empty and leads are submitted to the existing Google
# Form, whose responses sheet the team already uses. Override only if the form changes.
GOOGLE_FORM_ID=
LEADS_SHEET_URL=

# ── Spam protection (set both or neither). In production the visitor auto-reply email is
# only sent while Turnstile is on, so the form cannot be abused to email strangers. ───────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── AI (meta fill for EMPTY fields only + images for items without one) ──────────────
# Kill switch: set to "false" to stop every AI call immediately
AI_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API token with "Workers AI: Read/Edit" permission
CLOUDFLARE_API_TOKEN=
# Optional: AI Gateway name for caching, rate limits, spend limits and logs
CLOUDFLARE_AI_GATEWAY=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Fallback text provider if Cloudflare is not configured
OPENAI_API_KEY=
OPENAI_SEO_MODEL=gpt-4o-mini
