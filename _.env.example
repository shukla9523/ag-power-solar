# ==============================================================================
# AG POWER — Environment Variables Reference & Example Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit .env.local or sensitive secrets into source control.

# ------------------------------------------------------------------------------
# 1. Base URL & Deployment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:8000"

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Database & Authentication)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# 3. Google Sheets Lead Pipeline (Brief Part 12)
# ------------------------------------------------------------------------------
# Preferred mode: Google Apps Script Webhook URL (instant 13-field append)
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/your-deployment-id/exec"

# Fallback mode: Google Sheets API Service Account (optional if Webhook is used)
GOOGLE_SHEETS_ID="your-google-sheets-spreadsheet-id"
GOOGLE_SHEETS_RANGE="Leads!A:M"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. Telegram Bot Notification Service (Brief Part 12)
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# Target Group / Channel / Admin Chat ID (e.g. -100xxxxxxxxxx or user ID)
TELEGRAM_CHAT_ID="-1001234567890"

# ------------------------------------------------------------------------------
# 5. Security, Administration & Rate Limiting
# ------------------------------------------------------------------------------
OWNER_EMAIL="contact@electroglobal.in"
CUSTOM_ADMIN_PATH="admin-secret-portal"
REQUIRE_ADMIN_MFA="false"
PREVIEW_SECRET="generate-a-secure-random-preview-string"
CRON_SECRET="generate-a-secure-random-cron-secret"
PUBLISH_API_KEY="generate-a-secure-random-publish-api-key"
IP_HASH_SALT="generate-a-secure-random-salt-for-privacy-safe-ip-hashing"

# ------------------------------------------------------------------------------
# 6. Form Spam Protection (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Optional: If unset or empty, forms gracefully skip captcha verification in development
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 7. Email Notification Services (Optional fallbacks)
# ------------------------------------------------------------------------------
MAIL_FROM="AG POWER <enquiry@agpower.in>"
MAIL_FROM_NAME="AG POWER Solar Solutions"

# Mailflare / MailX HTTPS API
MAILFLARE_URL=""
MAILFLARE_API_KEY=""
MAILFLARE_MAILBOX_ID=""

# SMTP Fallback (Zoho / Custom SMTP)
ZOHO_SMTP_HOST="smtp.zoho.in"
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_USER=""
ZOHO_SMTP_PASS=""
